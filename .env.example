# Copy this file to .env and edit.
# SECRET_KEY is optional locally (one is generated into instance/secret.key).
# Set your own long random value in production.
SECRET_KEY=
FLASK_DEBUG=1
TIMEZONE=Asia/Kolkata
CONTACT_EMAIL=you@yourdomain.com
# Set to 1 once the site is served over HTTPS
COOKIE_SECURE=0
# Optional. Default is a SQLite file in instance/
# DATABASE_URL=

# Optional email for password reset. If MAIL_SERVER is empty, the reset link is
# printed in the terminal where you run the app (fine for local use).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
